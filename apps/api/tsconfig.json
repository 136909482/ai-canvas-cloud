{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "paths": {
      "@ai-canvas-cloud/contracts": ["../../packages/contracts/src/index.ts"],
      "@ai-canvas-cloud/contracts/http-schema": [
        "../../packages/contracts/src/httpSchema.ts"
      ],
      "@ai-canvas-cloud/server": ["../../server/index.ts"],
      "@ai-canvas-cloud/server/modules/admin": [
        "../../server/modules/admin/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/announcements": [
        "../../server/modules/announcements/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/assets": [
        "../../server/modules/assets/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/auth": [
        "../../server/modules/auth/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/community": [
        "../../server/modules/community/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/generation-telemetry": [
        "../../server/modules/generation-telemetry/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/generation-task-records": [
        "../../server/modules/generation-task-records/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/mail": [
