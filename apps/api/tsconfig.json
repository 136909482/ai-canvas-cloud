        "../../server/modules/project-snapshots/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/projects": [
        "../../server/modules/projects/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/settings": [
        "../../server/modules/settings/index.ts"
      ],
      "@ai-canvas-cloud/server/modules/workspaces": [
        "../../server/modules/workspaces/index.ts"
      ],
      "@ai-canvas-cloud/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../server" },
    { "path": "../../packages/shared" }
