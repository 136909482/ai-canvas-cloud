{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/apps-web-tsconfig-app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ai-canvas-cloud/contracts": ["../../packages/contracts/src/index.ts"],
      "@ai-canvas-cloud/project-graph": ["../../packages/project-graph/src/index.ts"],
      "@ai-canvas-cloud/shared": ["../../packages/shared/src/index.ts"]
    },
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
