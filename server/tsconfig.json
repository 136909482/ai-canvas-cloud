{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "@ai-canvas-cloud/contracts": ["../packages/contracts/src/index.ts"],
      "@ai-canvas-cloud/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "references": [
    { "path": "../packages/contracts" },
    { "path": "../packages/shared" }
  ],
  "include": [
    "index.ts",
    "staticSite.ts",
    "db/**/*.ts",
    "env/**/*.ts",
    "modules/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
