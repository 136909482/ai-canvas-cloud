NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=8787
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-before-production
WEB_PUBLIC_URL=http://localhost:5173
# 生产/staging 只填写可信 Web origin，逗号分隔；不得包含路径、凭据、query 或 fragment。
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_SEED_ADMIN=false
DEV_SEED_ADMIN_EMAIL=admin@example.com
# DEV_SEED_ADMIN_PASSWORD 只写入本机 .env，不提交到 Git；密码长度仍需至少 10 位。

WORKER_SHUTDOWN_TIMEOUT_MS=10000
WORKER_INSTANCE_ID=worker-local-1
WORKER_TASK_QUEUE_NAME=ai-canvas-generation
WORKER_OUTBOX_DISPATCH_INTERVAL_MS=1000
WORKER_OUTBOX_BATCH_SIZE=25
WORKER_OUTBOX_CLAIM_TTL_MS=30000
WORKER_OUTBOX_RETRY_BASE_MS=1000
WORKER_OUTBOX_RETRY_MAX_MS=60000
WORKER_TASK_CONCURRENCY=5
WORKER_TASK_LEASE_TTL_MS=30000
WORKER_TASK_LEASE_HEARTBEAT_MS=10000
WORKER_TASK_RECOVERY_INTERVAL_MS=15000
WORKER_TASK_RECOVERY_BATCH_SIZE=25
WORKER_TASK_RETRY_BASE_MS=5000
WORKER_TASK_RETRY_MAX_MS=300000

DATABASE_URL=postgres://ai_canvas_cloud:ai_canvas_cloud@127.0.0.1:5432/ai_canvas_cloud
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
# 浏览器可达的签名 URL endpoint；本地与内部 endpoint 相同，staging/production 必须单独使用 HTTPS public endpoint。
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ai-canvas-cloud-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# 版本号:base64(32字节密钥)，轮换时保留旧版本并提高 ACTIVE 版本；不得提交生产值。
PROVIDER_CREDENTIAL_KEYS=1:replace-with-base64-encoded-32-byte-key
PROVIDER_CREDENTIAL_ACTIVE_KEY_VERSION=1
