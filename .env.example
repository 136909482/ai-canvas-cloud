NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=8787
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-before-production
WEB_PUBLIC_URL=http://localhost:5173
DEV_SEED_ADMIN=false
DEV_SEED_ADMIN_EMAIL=admin@example.com
# DEV_SEED_ADMIN_PASSWORD 只写入本机 .env，不提交到 Git；密码长度仍需至少 10 位。

WORKER_SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgres://ai_canvas_cloud:ai_canvas_cloud@127.0.0.1:5432/ai_canvas_cloud
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ai-canvas-cloud-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# 版本号:base64(32字节密钥)，轮换时保留旧版本并提高 ACTIVE 版本；不得提交生产值。
PROVIDER_CREDENTIAL_KEYS=1:replace-with-base64-encoded-32-byte-key
PROVIDER_CREDENTIAL_ACTIVE_KEY_VERSION=1
