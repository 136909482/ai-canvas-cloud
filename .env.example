NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=8787
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-before-production
WEB_PUBLIC_URL=http://localhost:5173
# 生产/staging 只填写可信 Web origin，逗号分隔；不得包含路径、凭据、query 或 fragment。
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_SEED_ADMIN=false
DEV_SEED_ADMIN_EMAIL=admin@example.com
# DEV_SEED_ADMIN_PASSWORD 只写入本机 .env，不提交到 Git；密码长度仍需至少 10 位。


DATABASE_URL=postgres://ai_canvas_cloud:ai_canvas_cloud@127.0.0.1:5432/ai_canvas_cloud
# 发布/迁移角色与普通 API 运行角色必须分离；本地先迁移，再运行 db:roles:provision 自动生成未提交凭据。
MIGRATION_DATABASE_URL=postgres://ai_canvas_migration:replace-me@127.0.0.1:5432/ai_canvas_cloud
APP_DATABASE_ROLE=ai_canvas_cloud_app
# APP_DATABASE_PASSWORD 只写入本机 .env，不提交到 Git。

ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8788
ADMIN_BETTER_AUTH_URL=http://127.0.0.1:8788
# ADMIN_BETTER_AUTH_SECRET 必须与普通 BETTER_AUTH_SECRET 不同，只写入本机 .env。
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=5174
ADMIN_WEB_PUBLIC_URL=http://localhost:5174
ADMIN_WEB_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ADMIN_DATABASE_ROLE=ai_canvas_cloud_admin
# ADMIN_DATABASE_PASSWORD 与 ADMIN_DATABASE_URL 由 db:roles:provision 写入本机 .env。
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
# 浏览器可达的签名 URL endpoint；本地与内部 endpoint 相同，staging/production 必须单独使用 HTTPS public endpoint。
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ai-canvas-cloud-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
