# Copy to production.env, keep it chmod 600, and replace every replace-with-* value.
# Do not commit production.env. URL-encode reserved characters in database and Redis passwords.
NODE_ENV=production
ASSET_MAINTENANCE_API_URL=http://api:8787
ASSET_MAINTENANCE_TOKEN=replace-with-at-least-32-random-characters
DEPLOYMENT_ENV=production
LOG_LEVEL=info

# Immutable Docker Hub image references are recommended. Do not deploy mutable latest tags.
API_IMAGE=docker.io/replace-with-namespace/ai-canvas-cloud-api:replace-with-git-sha
WEB_IMAGE=docker.io/replace-with-namespace/ai-canvas-cloud-web:replace-with-git-sha
ADMIN_API_IMAGE=docker.io/replace-with-namespace/ai-canvas-cloud-admin-api:replace-with-git-sha
ADMIN_WEB_IMAGE=docker.io/replace-with-namespace/ai-canvas-cloud-admin-web:replace-with-git-sha
RELEASE_IMAGE=docker.io/replace-with-namespace/ai-canvas-cloud-release:replace-with-git-sha

WEB_PORT=8080
ADMIN_WEB_PORT=8081
WEB_PUBLIC_URL=https://replace-with-web-domain
BETTER_AUTH_URL=https://replace-with-web-domain
WEB_ALLOWED_ORIGINS=https://replace-with-web-domain
BETTER_AUTH_SECRET=replace-with-production-random-secret-at-least-32-characters

ADMIN_WEB_PUBLIC_URL=https://replace-with-admin-domain
ADMIN_WEB_ALLOWED_ORIGINS=https://replace-with-admin-domain
ADMIN_BETTER_AUTH_URL=https://replace-with-admin-domain
# db:roles:provision generates this independent secret when it is empty.
ADMIN_BETTER_AUTH_SECRET=

# Use the RDS database owner only for migrations and role provisioning.
MIGRATION_DATABASE_URL=postgresql://replace-with-rds-owner:replace-with-rds-password@replace-with-rds-private-host:5432/ai_canvas_cloud_production?sslmode=require
APP_DATABASE_ROLE=ai_canvas_cloud_app
ADMIN_DATABASE_ROLE=ai_canvas_cloud_admin
# db:roles:provision replaces these two runtime URLs with least-privilege roles.
DATABASE_URL=postgresql://ai_canvas_cloud_app:replace-with-temporary-password@replace-with-rds-private-host:5432/ai_canvas_cloud_production?sslmode=require
ADMIN_DATABASE_URL=postgresql://ai_canvas_cloud_admin:replace-with-temporary-password@replace-with-rds-private-host:5432/ai_canvas_cloud_production?sslmode=require

REDIS_URL=redis://:replace-with-redis-password@replace-with-redis-private-host:6379/0

# Aliyun OSS uses the regional endpoint here; signed URLs use the bucket origin below.
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=ai-canvas-cloud-production-assets
S3_PUBLIC_ORIGIN=https://ai-canvas-cloud-production-assets.oss-cn-hangzhou.aliyuncs.com
S3_FORCE_PATH_STYLE=false
S3_REGION=cn-hangzhou
S3_ACCESS_KEY_ID=replace-with-production-ram-access-key
S3_SECRET_ACCESS_KEY=replace-with-production-ram-secret
OBJECT_STORAGE_CREDENTIAL_ACTIVE_KEY_VERSION=1
OBJECT_STORAGE_CREDENTIAL_KEYS={"1":"replace-with-base64-encoded-32-byte-key"}

AUTH_EMAIL_TRANSPORT=managed
SMTP_CREDENTIAL_ACTIVE_KEY_VERSION=1
SMTP_CREDENTIAL_KEYS={"1":"replace-with-base64-encoded-32-byte-key"}

DEPLOYMENT_RESOURCE_NAMESPACE=ai-canvas-cloud-production
DEPLOYMENT_CREDENTIAL_NAMESPACE=ai-canvas-cloud-production-credentials
DATABASE_RESOURCE_ID=ai-canvas-cloud-production-rds
REDIS_RESOURCE_ID=ai-canvas-cloud-production-redis
S3_RESOURCE_ID=ai-canvas-cloud-production-oss
MAIL_RESOURCE_ID=ai-canvas-cloud-production-mail
PERSISTENCE_RESOURCE_ID=ai-canvas-cloud-production-managed-services
DATABASE_CREDENTIAL_ID=ai-canvas-cloud-production-rds-credential
REDIS_CREDENTIAL_ID=ai-canvas-cloud-production-redis-credential
S3_CREDENTIAL_ID=ai-canvas-cloud-production-oss-credential
MAIL_CREDENTIAL_ID=ai-canvas-cloud-production-mail-credential
