# Copy to staging.env and replace every replace-with-* value in the deployment secret manager.
# This file intentionally contains no usable domain, password, token, or API key.
NODE_ENV=staging
DEPLOYMENT_ENV=staging

WEB_PUBLIC_URL=https://staging-web.replace-with-real-domain
BETTER_AUTH_URL=https://staging-web.replace-with-real-domain
WEB_ALLOWED_ORIGINS=https://staging-web.replace-with-real-domain
BETTER_AUTH_SECRET=replace-with-staging-random-secret-at-least-32-characters

POSTGRES_DB=ai_canvas_cloud_staging
POSTGRES_USER=ai_canvas_cloud_staging
POSTGRES_PASSWORD=replace-with-staging-postgres-password
DATABASE_URL=postgres://ai_canvas_cloud_staging:replace-with-staging-postgres-password@postgres:5432/ai_canvas_cloud_staging

REDIS_PASSWORD=replace-with-staging-redis-password
REDIS_URL=redis://:replace-with-staging-redis-password@redis:6379/0

S3_ENDPOINT=http://object-storage:9000
S3_PUBLIC_ENDPOINT=https://staging-storage.replace-with-real-domain
S3_PUBLIC_ORIGIN=https://staging-storage.replace-with-real-domain
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=ai-canvas-cloud-staging-assets
S3_ACCESS_KEY_ID=staging-replace-with-object-access-key
S3_SECRET_ACCESS_KEY=replace-with-staging-object-secret
OBJECT_STORAGE_CREDENTIAL_ACTIVE_KEY_VERSION=1
OBJECT_STORAGE_CREDENTIAL_KEYS={"1":"replace-with-base64-encoded-32-byte-key"}

AUTH_EMAIL_TRANSPORT=managed
SMTP_CREDENTIAL_ACTIVE_KEY_VERSION=1
SMTP_CREDENTIAL_KEYS={"1":"replace-with-staging-base64-encoded-32-byte-key"}
# 首次在后台发布配置前保留旧 SMTP 变量作为回退；确认 managed 投递成功后删除 SMTP_PASSWORD。
SMTP_HOST=smtp.staging.replace-with-real-mail-host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=no-reply@staging.replace-with-real-domain
SMTP_USERNAME=staging-replace-with-mail-user
SMTP_PASSWORD=replace-with-staging-mail-password

DEPLOYMENT_RESOURCE_NAMESPACE=ai-canvas-cloud-staging
DEPLOYMENT_CREDENTIAL_NAMESPACE=ai-canvas-cloud-staging-credentials
DATABASE_RESOURCE_ID=ai-canvas-cloud-staging-postgres
REDIS_RESOURCE_ID=ai-canvas-cloud-staging-redis
S3_RESOURCE_ID=ai-canvas-cloud-staging-bucket
MAIL_RESOURCE_ID=ai-canvas-cloud-staging-mail
PERSISTENCE_RESOURCE_ID=ai-canvas-cloud-staging-volumes
DATABASE_CREDENTIAL_ID=ai-canvas-cloud-staging-postgres-credential
REDIS_CREDENTIAL_ID=ai-canvas-cloud-staging-redis-credential
S3_CREDENTIAL_ID=ai-canvas-cloud-staging-object-credential
MAIL_CREDENTIAL_ID=ai-canvas-cloud-staging-mail-credential

STAGING_WEB_PORT=8080

# P7-8 backup and restore-only resources. All values remain placeholders.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
OBJECT_NONCURRENT_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=replace-with-staging-backup-base64-32-byte-key
BACKUP_S3_ENDPOINT=http://backup-storage:9000
BACKUP_S3_BUCKET=ai-canvas-cloud-staging-backups
BACKUP_S3_ACCESS_KEY_ID=staging-backup-replace-with-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-staging-backup-object-secret
PUSHGATEWAY_URL=http://pushgateway:9091

RESTORE_BACKUP_ID=replace-with-backup-id-from-manifest
RESTORE_POSTGRES_DB=ai_canvas_cloud_staging_restore
RESTORE_POSTGRES_USER=ai_canvas_cloud_staging_restore
RESTORE_POSTGRES_PASSWORD=replace-with-staging-restore-postgres-password
RESTORE_DATABASE_URL=postgres://ai_canvas_cloud_staging_restore:replace-with-staging-restore-postgres-password@restore-postgres:5432/ai_canvas_cloud_staging_restore
RESTORE_REDIS_PASSWORD=replace-with-staging-restore-redis-password
RESTORE_REDIS_URL=redis://:replace-with-staging-restore-redis-password@restore-redis:6379/0
RESTORE_S3_ENDPOINT=http://restore-object-storage:9000
RESTORE_S3_BUCKET=ai-canvas-cloud-staging-restore-assets
RESTORE_S3_ACCESS_KEY_ID=staging-restore-replace-with-access-key
RESTORE_S3_SECRET_ACCESS_KEY=replace-with-staging-restore-object-secret
RESTORE_DATABASE_RESOURCE_ID=ai-canvas-cloud-staging-restore-postgres
RESTORE_REDIS_RESOURCE_ID=ai-canvas-cloud-staging-restore-redis
RESTORE_S3_RESOURCE_ID=ai-canvas-cloud-staging-restore-bucket
RESTORE_AUDIT_MIN_WORKSPACES=2
RESTORE_RESET_CONFIRMED=true
