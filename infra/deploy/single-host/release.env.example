# setup.sh generates secrets/release.env with mode 600. Do not copy this file by hand.
# Only the public and Admin domains are entered during setup. OSS is configured later in Admin.
APP_IMAGE_SOURCE=archive
APP_IMAGE_ARCHIVE=ai-canvas-cloud-single-host-image.tar
APP_LOCAL_IMAGE=ai-canvas-cloud-single-host:offline
APP_IMAGE=
ASSET_MAINTENANCE_TOKEN=
PUBLIC_HTTP_ADAPTER=legacy
ADMIN_HTTP_ADAPTER=legacy
